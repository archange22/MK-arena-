# Exemple uniquement : ne jamais y placer un vrai token.
DISCORD_TOKEN=votre_token_discord_ici
PREFIX=!

# Base de données : sqlite (par défaut) ou supabase
DATABASE_BACKEND=sqlite
SQLITE_PATH=mk_arena.db
# Seulement si DATABASE_BACKEND=supabase : URI PostgreSQL du projet MK Arena dédié
# Ne jamais utiliser une clé anon/publishable à la place de l'URI PostgreSQL.
SUPABASE_DB_URL=
